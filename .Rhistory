extract_pdp_v2 <- function(pdp_obj, var_name) {
# Chercher le bon slot selon la version
if (!is.null(pdp_obj$survOutput) && length(pdp_obj$survOutput) > 0) {
# Versions récentes : survOutput
vals <- rowMeans(pdp_obj$survOutput, na.rm = TRUE)
ylab <- "Survie moyenne"
} else if (!is.null(pdp_obj$mortality) && length(pdp_obj$mortality) > 0) {
# partial.type = "mort" → mortalité
vals <- rowMeans(as.matrix(pdp_obj$mortality), na.rm = TRUE)
ylab <- "Mortalité cumulée moyenne"
} else if (!is.null(pdp_obj$surv) && length(pdp_obj$surv) > 0) {
# Anciennes versions
vals <- rowMeans(pdp_obj$surv, na.rm = TRUE)
ylab <- "Survie moyenne"
} else {
stop(paste("Aucun slot de survie trouvé pour", var_name,
"- slots disponibles:", paste(names(pdp_obj), collapse = ", ")))
}
# Valeurs de x (variable partielle)
x_vals <- pdp_obj$xvar
tibble(
x    = x_vals,
y    = vals,
var  = var_name,
ylab = ylab
)
}
# ── Construire le data.frame PDP
pdp_df <- tryCatch(
bind_rows(
extract_pdp_v2(pdp_age,    "Age"),
extract_pdp_v2(pdp_col1a2, "COL1A2"),
extract_pdp_v2(pdp_egfr,   "eGFR")
),
error = function(e) {
cat("Erreur extract_pdp_v2 :", conditionMessage(e), "\n")
NULL
}
)
print(names(pdp_age))
ggplot(pdp_df, aes(x = x, y = y, color = var)) +
geom_line(linewidth = 1.2) +
geom_smooth(method = "loess", se = TRUE,
alpha = 0.12, linewidth = 0.5) +
facet_wrap(~ var, scales = "free_x", ncol = 3) +
scale_color_manual(values = couleurs_pdp, guide = "none") +
labs(
title    = "Partial Dependence Plots — RSF",
subtitle = sprintf("Effet marginal sur la mortalité cumulée | temps médian = %.2f",
median(fit_rsf$time.interest)),
x        = "Valeur du prédicteur",
y        = unique(pdp_df$ylab)[1]
) +
theme_minimal(base_size = 12) +
theme(
plot.title       = element_text(face = "bold", size = 13),
plot.subtitle    = element_text(color = "grey40", size = 10),
strip.text       = element_text(face = "bold", size = 12),
panel.grid.minor = element_blank()
)
DataBasePUV$U25eGFR
max(DataBasePUV$U25eGFR)
pdp_egfr$survOutput
pdp_egfr$event.info$event
COL1A2_COL <- "99918620"   # ← nom exact de la colonne COL1A2
EGFR_COL   <- "eGFR"       # ← nom exact de la colonne eGFR
TIME_COL   <- "time"       # ← temps jusqu'à l'événement
EVENT_COL  <- "statut"     # ← 1 = KF, 0 = censuré/NoKF
N_TREES    <- 1000         # ← nombre d'arbres (1000 recommandé)
SEED       <- 42
cat("=== ÉTAPE 1 : Préparation ===\n\n")
merged_data$time =  merged_data_all$time.x
df_rsf <- merged_data %>%
filter(statut %in% c(0, 1)) %>%
select(
time   = all_of(TIME_COL),
event  = all_of(EVENT_COL),
Age,
COL1A2 = all_of(COL1A2_COL),
eGFR   = all_of(EGFR_COL)
) %>%
mutate(
time  = as.numeric(time),
event = as.integer(event)
) %>%
filter(
!is.na(time) & !is.na(event),
time > 0
)
cat(sprintf("N patients          : %d\n",   nrow(df_rsf)))
cat(sprintf("Événements KF       : %d\n",   sum(df_rsf$event)))
cat(sprintf("Censurés (NoKF)     : %d\n",   sum(df_rsf$event == 0)))
cat(sprintf("Temps médian        : %.1f\n", median(df_rsf$time)))
cat(sprintf("Étendue temps       : %.1f – %.1f\n",
min(df_rsf$time), max(df_rsf$time)))
cat(sprintf("NA résiduels        : %d\n",   sum(is.na(df_rsf))))
cat("\n=== ÉTAPE 2 : Entraînement RSF ===\n\n")
set.seed(SEED)
library(randomForestSRC)
fit_rsf <- rfsrc(
Surv(time, event) ~ Age + COL1A2 + eGFR,
data          = df_rsf,
ntree         = N_TREES,
nodesize      = 5,           # taille min des feuilles (adapter si petit n)
splitrule     = "logrank",   # règle de split adaptée à la survie
importance    = "permute",   # importance par permutation
na.action     = "na.impute", # imputation si NA résiduels
seed          = SEED
)
cat("RSF entraîné.\n")
print(fit_rsf)
# Erreur OOB (Out-of-Bag) — équivalent du taux d'erreur de validation
cat(sprintf("\nErreur OOB (1 - C-index) : %.4f\n", fit_rsf$err.rate[N_TREES]))
cat(sprintf("C-index OOB              : %.4f\n",   1 - fit_rsf$err.rate[N_TREES]))
cat("\n=== ÉTAPE 3 : Importance des variables ===\n\n")
importance_df <- data.frame(
variable   = names(fit_rsf$importance),
importance = fit_rsf$importance
) %>%
arrange(desc(importance)) %>%
mutate(
variable = fct_reorder(variable, importance),
couleur  = case_when(
variable == "eGFR"   ~ "#10B981",
variable == "COL1A2" ~ "#8B5CF6",
variable == "Age"    ~ "#F59E0B"
)
)
print(importance_df)
p_importance <- ggplot(importance_df,
aes(x = variable, y = importance, fill = couleur)) +
geom_col(width = 0.55) +
geom_text(aes(label = sprintf("%.4f", importance)),
hjust = -0.15, size = 4, fontface = "bold") +
coord_flip() +
scale_fill_identity() +
scale_y_continuous(expand = expansion(mult = c(0, 0.2))) +
labs(
title    = "Importance des variables — RSF",
subtitle = sprintf("Permutation importance | %d arbres | C-index OOB = %.3f",
N_TREES, 1 - fit_rsf$err.rate[N_TREES]),
x        = "",
y        = "Importance (permutation)"
) +
theme_minimal(base_size = 13) +
theme(
plot.title       = element_text(face = "bold", size = 14),
plot.subtitle    = element_text(color = "grey40", size = 10),
panel.grid.minor = element_blank(),
panel.grid.major.y = element_blank()
)
cat("\n=== ÉTAPE 4 : Courbes de survie ===\n\n")
# Prédictions OOB (honnêtes — pas sur données d'entraînement)
pred_rsf <- randomForestSRC::predict.rfsrc(fit_rsf)
length(pred_rsf)
# Score de risque individuel (mortalité cumulée OOB)
df_rsf$risk_score <- pred_rsf$predicted
# Tertiles de risque pour stratification
df_rsf <- df_rsf %>%
mutate(
risk_group = cut(risk_score,
breaks = quantile(risk_score, c(0, 1/3, 2/3, 1)),
labels = c("Faible risque", "Risque intermédiaire", "Risque élevé"),
include.lowest = TRUE)
)
cat("Distribution des groupes de risque :\n")
print(table(df_rsf$risk_group, df_rsf$event))
# Kaplan-Meier par groupe de risque RSF
km_fit <- survfit(Surv(time, event) ~ risk_group, data = df_rsf)
p_km <- survminer::ggsurvplot(
km_fit,
data         = df_rsf,
palette      = c("#10B981", "#F59E0B", "#D85A30"),
pval         = TRUE,
pval.method  = TRUE,
conf.int     = TRUE,
risk.table   = TRUE,
risk.table.height = 0.28,
legend.labs  = c("Faible risque", "Risque intermédiaire", "Risque élevé"),
legend.title = "Groupe RSF",
title        = "Survie sans insuffisance rénale — stratifiée par score RSF",
xlab         = "Temps",
ylab         = "Probabilité de survie sans KF",
ggtheme      = theme_minimal(base_size = 12)
)
# Sauvegarder KM
pdf("rsf_kaplan_meier.pdf", width = 10, height = 8)
km_fit
p_km
# Sauvegarder KM
pdf("rsf_kaplan_meier.pdf", width = 10, height = 8)
print(p_km)
dev.off()
cat("\n=== ÉTAPE 5 : Partial Dependence Plots ===\n\n")
pdp_age <- partial(fit_rsf,
partial.xvar  = "Age",
partial.type  = "mort",
partial.time  = median(fit_rsf$time.interest))
pdp_col1a2 <- partial(fit_rsf,
partial.xvar  = "COL1A2",
partial.type  = "mort",
partial.time  = median(fit_rsf$time.interest))
pdp_egfr <- partial(fit_rsf,
partial.xvar  = "eGFR",
partial.type  = "mort",
partial.time  = median(fit_rsf$time.interest))
# ── Vérifier la structure retournée
cat("Slots disponibles dans pdp_age :\n")
print(names(pdp_age))
cat("\nDimensions survOutput :", dim(pdp_age$survOutput), "\n")
cat("Dimensions mortality  :", dim(pdp_age$mortality),   "\n")
# ── Fonction d'extraction
extract_pdp_v2 <- function(pdp_obj, var_name) {
# Chercher le bon slot selon la version
if (!is.null(pdp_obj$survOutput) && length(pdp_obj$survOutput) > 0) {
# Versions récentes : survOutput
vals <- rowMeans(pdp_obj$survOutput, na.rm = TRUE)
ylab <- "Survie moyenne"
} else if (!is.null(pdp_obj$mortality) && length(pdp_obj$mortality) > 0) {
# partial.type = "mort" → mortalité
vals <- rowMeans(as.matrix(pdp_obj$mortality), na.rm = TRUE)
ylab <- "Mortalité cumulée moyenne"
} else if (!is.null(pdp_obj$surv) && length(pdp_obj$surv) > 0) {
# Anciennes versions
vals <- rowMeans(pdp_obj$surv, na.rm = TRUE)
ylab <- "Survie moyenne"
} else {
stop(paste("Aucun slot de survie trouvé pour", var_name,
"- slots disponibles:", paste(names(pdp_obj), collapse = ", ")))
}
# Valeurs de x (variable partielle)
x_vals <- pdp_obj$xvar
tibble(
x    = x_vals,
y    = vals,
var  = var_name,
ylab = ylab
)
}
# ── Construire le data.frame PDP
pdp_df <- tryCatch(
bind_rows(
extract_pdp_v2(pdp_age,    "Age"),
extract_pdp_v2(pdp_col1a2, "COL1A2"),
extract_pdp_v2(pdp_egfr,   "eGFR")
),
error = function(e) {
cat("Erreur extract_pdp_v2 :", conditionMessage(e), "\n")
NULL
}
)
str(pdp_df)
# ── Si toujours en erreur : utiliser plot.variable() nativement
if (is.null(pdp_df)) {
cat("\nFallback : plot.variable() natif randomForestSRC\n")
pdf("rsf_pdp.pdf", width = 12, height = 5)
par(mfrow = c(1, 3))
plot.variable(fit_rsf,
xvar.names = "Age",
partial    = TRUE,
main       = "PDP — Age",
ylab       = "Mortalité RSF")
plot.variable(fit_rsf,
xvar.names = "COL1A2",
partial    = TRUE,
main       = "PDP — COL1A2",
ylab       = "Mortalité RSF")
plot.variable(fit_rsf,
xvar.names = "eGFR",
partial    = TRUE,
main       = "PDP — eGFR",
ylab       = "Mortalité RSF")
dev.off()
cat("PDP sauvegardé via plot.variable() : rsf_pdp.pdf\n")
} else {
# ── Graphique ggplot si extraction réussie
couleurs_pdp <- c("Age" = "#F59E0B", "COL1A2" = "#8B5CF6", "eGFR" = "#10B981")
p_pdp <- ggplot(pdp_df, aes(x = x, y = y, color = var)) +
geom_line(linewidth = 1.2) +
geom_smooth(method = "loess", se = TRUE,
alpha = 0.12, linewidth = 0.5) +
facet_wrap(~ var, scales = "free_x", ncol = 3) +
scale_color_manual(values = couleurs_pdp, guide = "none") +
labs(
title    = "Partial Dependence Plots — RSF",
